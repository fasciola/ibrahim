{
  "name": "ConsultationInquiry",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string",
      "description": "Unique human-readable inquiry reference, e.g. IS-2026-A1B2C3"
    },
    "full_name": {
      "type": "string",
      "minLength": 2
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone_country_code": {
      "type": "string",
      "description": "Dial code, e.g. +971"
    },
    "phone_number": {
      "type": "string"
    },
    "country_of_residence": {
      "type": "string"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "WhatsApp",
        "Phone Call",
        "Email"
      ]
    },
    "service_required": {
      "type": "string",
      "enum": [
        "Mainland Company Formation",
        "Free-Zone Company Formation",
        "Offshore Company Formation",
        "Visa Services",
        "Golden Visa",
        "Corporate Bank Account Support",
        "Corporate Tax or VAT",
        "License Renewal",
        "PRO Services",
        "Legal or Business Consultation",
        "Not Sure Yet"
      ]
    },
    "business_activity": {
      "type": "string"
    },
    "shareholder_count": {
      "type": "number",
      "minimum": 1
    },
    "visa_count": {
      "type": "number",
      "minimum": 0
    },
    "estimated_timeline": {
      "type": "string",
      "enum": [
        "As Soon as Possible",
        "Within 30 Days",
        "Within 1-3 Months",
        "More Than 3 Months",
        "Researching Options"
      ]
    },
    "estimated_budget": {
      "type": "string",
      "enum": [
        "Under AED 10,000",
        "AED 10,000-20,000",
        "AED 20,000-40,000",
        "Above AED 40,000",
        "Not Sure Yet",
        "Prefer Not to Say"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 1500
    },
    "privacy_consent": {
      "type": "boolean"
    },
    "whatsapp_consent": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Contacted",
        "Consultation Scheduled",
        "Qualified",
        "Converted",
        "Not Proceeding",
        "Spam"
      ],
      "default": "New"
    },
    "source_page": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string",
      "description": "Private admin notes, never exposed to the public"
    },
    "website_field": {
      "type": "string",
      "description": "Honeypot field - must remain empty"
    }
  },
  "required": [
    "full_name",
    "email",
    "phone_number",
    "country_of_residence",
    "preferred_contact_method",
    "service_required",
    "privacy_consent"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}